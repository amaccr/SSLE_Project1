<!-- SSLE custom rules. Pushed to /var/ossec/etc/rules/local_rules.xml on siem-01 (the manager). -->
<group name="web,attack,dos,">

  <!-- A single nginx HTTP 429 = one rate-limit trip. nginx returns 429 only when a client exceeds
       the per-IP limit, so a 429 is already a strong "this source is abusive" signal. 31101 is the
       built-in "web 4xx" rule; this narrows it to status 429 so we count only rate-limit trips. -->
  <rule id="100100" level="3">
    <if_sid>31101</if_sid>
    <id>^429$</id>
    <description>nginx rate limit tripped (HTTP 429) from $(srcip)</description>
    <group>dos,</group>
  </rule>

  <!-- DoS confirmed: >=30 rate-limit trips (429) from the SAME source IP within 60s. Level 12 drives
       the firewall-drop active response (timed block). Threshold well above any legitimate client. -->
  <rule id="100101" level="12" frequency="30" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>DoS: source IP $(srcip) hit the nginx rate limit >=30 times in 60s (HTTP 429 flood)</description>
    <group>dos,attack,pci_dss_6.5.9,</group>
  </rule>

</group>

<!-- Credential stuffing (threat 2). Reads the app's own JSON log (/var/log/ssle/api.log) via Wazuh's
     built-in JSON decoder. NOTE (verified with wazuh-logtest): the decoder maps the "user" key to the
     standard field dstuser, and keeps "src" as src (NOT srcip), so correlation uses <same_field>src and
     <different_field>dstuser, not <same_source_ip>. Only src is trustworthy (nginx + firewall); dstuser
     is attacker-controlled, so it is used only to COUNT distinct values, never trusted as content. -->
<group name="authentication_failures,attack,credential_stuffing,">

  <!-- One failed login recorded by the app. Level 5 like other auth failures. This is the raw event
       the correlation below counts; on its own it is just a wrong password. -->
  <rule id="100110" level="5">
    <decoded_as>json</decoded_as>
    <field name="app">^ssle-api$</field>
    <field name="event">^login_failed$</field>
    <description>SSLE login failed for user '$(dstuser)' from $(src) (reason: $(reason))</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Credential stuffing: the SAME source failing logins against >=8 DIFFERENT usernames within 60s.
       different_field dstuser is what separates this from a DoS brute-force (which hammers ONE user):
       stuffing sprays MANY distinct usernames. Threshold from the baseline (distinct-user failures per
       source ~= 0 in normal use). Level 10, and DELIBERATELY NO active response: a per-IP block is
       evaded by a botnet and blocking a shared/NAT IP would itself be a DoS. Response is per-account
       lockout in the app + this alert for a human. -->
  <rule id="100111" level="10" frequency="8" timeframe="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>src</same_field>
    <different_field>dstuser</different_field>
    <description>Credential stuffing: source $(src) failed logins against many distinct usernames in 60s</description>
    <group>credential_stuffing,attack,pci_dss_6.5.10,</group>
  </rule>

</group>

<!-- APT (threat 3) -- the CORRELATION threat: no single rule below proves an intrusion, the CHAIN does.
     Reads the same app JSON log as the credential-stuffing rules (/var/log/ssle/api.log). The custom JSON
     keys (event, app, sensor) are matched by name; "user" is mapped to dstuser and "src" kept as src by
     the decoder, exactly as noted for threat 2. -->
<group name="apt,attack,">

  <!-- The deliberately vulnerable /report endpoint was invoked (raw marker). Benign on its own: a legit
       report IS this event with a clean sensor id. Level 3 so it is recorded and the injection rule below
       can child off it. -->
  <rule id="100120" level="3">
    <decoded_as>json</decoded_as>
    <field name="app">^ssle-api$</field>
    <field name="event">^report$</field>
    <description>SSLE /report by '$(dstuser)' from $(src) (sensor=$(sensor))</description>
    <group>apt,</group>
  </rule>

  <!-- Command injection (APT EXECUTION stage): the sensor contains a character OUTSIDE the safe set
       ^[a-z0-9-]+$. Allowlist, not a bad-char blocklist, so no forgotten metacharacter can bypass it.
       A legitimate sensor id never does this, so it is a near-conclusive RCE attempt. Level 12, but NO
       active response (see docs/threats/apt.md "Response": auto-response is riskier here than for DoS).
       This is the anchor the correlation rule 100130 keys off. -->
  <rule id="100121" level="12">
    <if_sid>100120</if_sid>
    <field name="sensor" type="pcre2">[^a-z0-9-]</field>
    <description>APT: command injection in /report sensor from $(src) on $(host) (sensor=$(sensor))</description>
    <group>apt,command_injection,pci_dss_6.5.1,</group>
  </rule>

  <!-- APT LATERAL MOVEMENT stage: a blocked OUTBOUND attempt from an internal host to an internal target
       the call graph forbids. The host (h01) ships the Incus/nftables kernel drop lines from journald;
       Wazuh's BUILT-IN kernel/iptables decoder parses them (action, srcip, dstip, dstport, protocol) and
       raises the generic firewall rule 4100 at level 0. We child off 4100 and keep only the EGRESS drops
       (action eth0-egress = the outbound attempt, srcip = the foothold) between two INTERNAL hosts. The
       host agent already filters the journald stream to eth0-egress + PROTO=TCP, so the DHCP noise (UDP)
       never arrives. On its own this is only level 8 -- a one-off could be a misconfiguration or fat-finger;
       it becomes conclusive only in the chain (rule 100130). -->
  <rule id="100122" level="8">
    <if_sid>4100</if_sid>
    <action>eth0-egress</action>
    <srcip>10.10.0.0/16</srcip>
    <dstip>10.10.0.0/16</dstip>
    <description>APT recon: blocked connection from $(srcip) to $(dstip):$(dstport) (not in the call graph)</description>
    <group>apt,recon,</group>
  </rule>

  <!-- APT C2 / EXFIL stage: a site backend INITIATED a connection to the external actor network
       (192.168.100.0/24: client/attacker/public lb). A backend never does this legitimately (apt goes to
       the real internet, not here), so it is a reverse shell calling home or data exfiltration. The
       firewall allows it (broad apt egress rule), so it is logged by our host IDS rule (config/ssle_ids.nft,
       prefix SSLE-C2) rather than dropped; Wazuh's built-in kernel decoder parses it (rule 4100). This is
       the "new outbound connection not in the call graph" signal from docs/architecture.md. -->
  <rule id="100123" level="10">
    <if_sid>4100</if_sid>
    <action>SSLE-C2</action>
    <srcip>10.10.0.0/16</srcip>
    <description>APT C2: backend $(srcip) called out to the external network $(dstip):$(dstport) (reverse shell / exfil)</description>
    <group>apt,command_control,pci_dss_10.6.1,</group>
  </rule>

  <!-- APT CHAIN (the correlation): the SAME foothold both CALLED OUT to the attacker network (100123, C2)
       and PROBED internal hosts it may not reach (100122, recon), within 10 minutes. Neither leg proves an
       intrusion alone (a blocked probe could be a misconfig; one odd egress could be a fat-finger), but a
       host doing BOTH is a compromised host moving with intent -- the whole point of the APT "correlation"
       threat. Level 14, the highest in the project, because the chain is conclusive where no single leg is.
       Both legs are observed by the SAME agent (the host, h01) and carry the foothold's IP as srcip, so we
       correlate with <same_field>srcip</same_field>. This is deliberate: Wazuh's if_matched_sid correlation
       is PER-AGENT (verified -- a cross-agent timeframe correlation with the API-log injection never fired),
       so the robust chain is built from two host-observed network signals keyed on one field. The command
       injection itself stays a strong standalone alert (100121, level 12) -- the "how they got in". See
       docs/threats/apt.md "Detection" for this per-agent limitation and why it shapes the design. -->
  <rule id="100130" level="14" timeframe="600">
    <if_sid>100122</if_sid>
    <if_matched_sid>100123</if_matched_sid>
    <same_source_ip />

    <description>APT CHAIN: foothold $(srcip) called out to the attacker network AND probed internal hosts (recon) within 10m</description>
    <group>apt,attack,correlation,pci_dss_10.6.1,</group>
  </rule>

</group>
