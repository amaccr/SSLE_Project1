<!-- SSLE custom rules. Pushed to /var/ossec/etc/rules/local_rules.xml on siem-01 (the manager). -->
<group name="web,attack,dos,">

  <!-- A single nginx HTTP 429 = one rate-limit trip. nginx returns 429 only when a client exceeds
       the per-IP limit, so a 429 is already a strong "this source is abusive" signal. 31101 is the
       built-in "web 4xx" rule; this narrows it to status 429 so we count only rate-limit trips. -->
  <rule id="100100" level="3">
    <if_sid>31101</if_sid>
    <id>^429$</id>
    <description>nginx rate limit tripped (HTTP 429) from $(srcip)</description>
    <group>dos,</group>
  </rule>

  <!-- DoS confirmed: >=30 rate-limit trips (429) from the SAME source IP within 60s. Level 12 drives
       the firewall-drop active response (timed block). Threshold well above any legitimate client. -->
  <rule id="100101" level="12" frequency="30" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>DoS: source IP $(srcip) hit the nginx rate limit >=30 times in 60s (HTTP 429 flood)</description>
    <group>dos,attack,pci_dss_6.5.9,</group>
  </rule>

</group>

<!-- Credential stuffing (threat 2). Reads the app's own JSON log (/var/log/ssle/api.log) via Wazuh's
     built-in JSON decoder. NOTE (verified with wazuh-logtest): the decoder maps the "user" key to the
     standard field dstuser, and keeps "src" as src (NOT srcip), so correlation uses <same_field>src and
     <different_field>dstuser, not <same_source_ip>. Only src is trustworthy (nginx + firewall); dstuser
     is attacker-controlled, so it is used only to COUNT distinct values, never trusted as content. -->
<group name="authentication_failures,attack,credential_stuffing,">

  <!-- One failed login recorded by the app. Level 5 like other auth failures. This is the raw event
       the correlation below counts; on its own it is just a wrong password. -->
  <rule id="100110" level="5">
    <decoded_as>json</decoded_as>
    <field name="app">^ssle-api$</field>
    <field name="event">^login_failed$</field>
    <description>SSLE login failed for user '$(dstuser)' from $(src) (reason: $(reason))</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Credential stuffing: the SAME source failing logins against >=8 DIFFERENT usernames within 60s.
       different_field dstuser is what separates this from a DoS brute-force (which hammers ONE user):
       stuffing sprays MANY distinct usernames. Threshold from the baseline (distinct-user failures per
       source ~= 0 in normal use). Level 10, and DELIBERATELY NO active response: a per-IP block is
       evaded by a botnet and blocking a shared/NAT IP would itself be a DoS. Response is per-account
       lockout in the app + this alert for a human. -->
  <rule id="100111" level="10" frequency="8" timeframe="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>src</same_field>
    <different_field>dstuser</different_field>
    <description>Credential stuffing: source $(src) failed logins against many distinct usernames in 60s</description>
    <group>credential_stuffing,attack,pci_dss_6.5.10,</group>
  </rule>

</group>
