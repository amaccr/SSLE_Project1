// Service-architecture diagram for the report (docs/report.md, section 3).
// Zones are clusters; Graphviz routes the edges. Four edge classes (keyed in the
// report figure caption):
//   black  = application call graph        red    = attack path (from inet)
//   green dotted = Prometheus scrape/federate   purple dashed = Wazuh agent -> manager
// Render:  dot -Tpng docs/architecture.dot -o images/architecture.png
digraph arch {
  rankdir=TB;
  splines=true;
  compound=true;
  newrank=true;
  nodesep=0.4;
  ranksep=0.85;
  bgcolor="white";
  fontname="Helvetica";
  labelloc=t;
  label=<<b>Figure 1 — Service architecture: zones, application call graph, and the monitoring/SIEM plane</b>>;
  fontsize=15;

  node [shape=box, style="rounded,filled", fillcolor=white, color="#30363d",
        fontname="Helvetica", fontsize=11, margin="0.18,0.09"];
  edge [fontname="Helvetica", fontsize=9, color="#30363d"];

  // ---- inet ----
  subgraph cluster_inet {
    label="inet — 192.168.100.0/24  (outside world)";
    style="rounded,filled"; fillcolor="#fdecec"; color="#d64545"; labeljust="l";
    fontcolor="#d64545"; fontsize=12;
    client   [label="client-01 (.20)\nlegitimate user"];
    attacker [label="attacker-01..03\n(.66 / .67 / .68)\nbotnet of 3"];
  }

  // ---- site avr ----
  subgraph cluster_avr {
    label="site avr — ssle-avr  10.10.1.0/24";
    style="rounded,filled"; fillcolor="#e9f0fd"; color="#3f6cc4"; labeljust="l";
    fontcolor="#3f6cc4"; fontsize=12;
    lb        [label="lb-01 (nginx)\npublic .10:80 · eth0 .10",
               color="#d64545", penwidth=2.2];
    api1      [label="api-01 (.21)\nFlask + login :5000"];
    api2      [label="api-02 (.22)\nFlask + login :5000"];
    analytics [label="analytics-01 (.31)\n/stats · /average  (design)",
               style="rounded,dashed,filled", fillcolor="#f6f8fa"];
    db        [label="db-01 (.41)\nPostgreSQL :5432"];
  }

  // ---- ssle-mgmt ----
  subgraph cluster_mgmt {
    label="ssle-mgmt — 10.10.0.0/24  (monitoring + SIEM)";
    style="rounded,filled"; fillcolor="#e7f4ea"; color="#2f9e52"; labeljust="l";
    fontcolor="#2f9e52"; fontsize=12;
    prom [label="prom-01 (.10)\ncentral Prometheus"];
    siem [label="siem-01 (.20)\nWazuh manager + dashboard"];
  }

  // ---- site lis (built: scalability + bandwidth measurement, §6.3) ----
  lis [label="site lis  (built, §6.3)\napi-01.lis · db-01.lis · prom-01.lis (local, federated)\nssle-lis 10.10.2.0/24 — one build-script run",
       style="rounded,filled", fillcolor="#eef1f4",
       color="#30363d", fontcolor="#24292f", fontsize=10];

  // ---- physical host ----
  host [label="h01.ssle — physical host (the VM): runs every container  ·  host exporter (CPU/mem/net, :9101)  ·  Wazuh host agent (nft IDS + firewall-drop logs)",
        shape=box, style="rounded,filled", fillcolor="#eceff1",
        color="#90a4ae", fontsize=10];

  // ===== application call graph (black) =====
  client    -> lb  [label=":80"];
  lb        -> api1 [label=":5000"];
  lb        -> api2 [label=":5000"];
  lb        -> analytics [label=":5000", style=dashed];
  api1      -> db  [label=":5432"];
  api2      -> db  [label=":5432"];
  analytics -> db  [label=":5432 ro", style=dashed];

  // ===== attack path (red) =====
  attacker -> lb [label="stuffing / flood / APT entry",
                  color="#d64545", fontcolor="#d64545", penwidth=1.6];

  // ===== Prometheus scrape / federate (green dotted, don't constrain ranks) =====
  prom -> api1 [label="scrape :9102", color="#2f9e52", fontcolor="#2f9e52",
                style=dotted, penwidth=1.4, constraint=false];
  prom -> host [label="host exporter :9101", color="#2f9e52",
                fontcolor="#2f9e52", style=dotted, penwidth=1.4, constraint=false];
  prom -> lis  [label="federate :9090", color="#2f9e52", fontcolor="#2f9e52",
                style=dotted, penwidth=1.4, constraint=false];

  // ===== Wazuh agents (purple dashed, one representative flow) =====
  lb -> siem [label="Wazuh agents (every instance) :1514/1515",
              color="#8250df", fontcolor="#8250df", style=dashed,
              penwidth=1.4, constraint=false];

  // ===== layout hints =====
  {rank=same; api1; prom;}        // monitoring plane beside the app tier
  {rank=same; api2; siem;}
  siem -> lis  [style=invis];     // lis stacks below the mgmt plane
  db   -> host [style=invis, weight=10];  // host pinned to the bottom
}
